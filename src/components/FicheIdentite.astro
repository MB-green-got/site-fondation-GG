---
/*
  La fiche d'identité de la Fondation, affichée telle qu'elle est écrite
  dans src/data/fondation.js. Ce composant ne reformule rien, il recopie.
  C'est le seul endroit du site qui affiche ces phrases en bloc.
*/
import AValider from './AValider.astro';
import { fondation } from '../data/fondation.js';

const { titre = 'La Fondation en bref' } = Astro.props;
const estAValider = (v) => v && typeof v === 'object' && v.aValider;
---
<div class="dl">
  <h2>{titre}</h2>

  <div><dt>Nom</dt><dd>{fondation.nom}</dd></div>

  <div>
    <dt>Statut</dt>
    <dd>
      {fondation.statut}.
      {fondation.statutAValider && (
        <AValider quoi="La formulation exacte du statut. Un fonds abrité et une fondation abritée ne sont pas la même chose juridiquement, la bonne doit venir du juridique." />
      )}
    </dd>
  </div>

  <div><dt>Objectif</dt><dd>{fondation.objectif}</dd></div>

  <div><dt>Périmètre</dt><dd>{fondation.perimetre.join(', ')}.</dd></div>

  <div>
    <dt>Année de création</dt>
    <dd>{estAValider(fondation.anneeCreation)
      ? <AValider quoi={fondation.anneeCreation.quoi} />
      : fondation.anneeCreation}</dd>
  </div>

  <div>
    <dt>Montant cumulé versé</dt>
    <dd>{estAValider(fondation.montantCumule)
      ? <AValider quoi={fondation.montantCumule.quoi} />
      : fondation.montantCumule}</dd>
  </div>

  <div>
    <dt>Comité</dt>
    <dd>
      <ul class="plain">
        {fondation.comite.membres.map((m) => (
          <li>
            {m.linkedin
              ? <a href={m.linkedin} target="_blank" rel="noopener">{m.nom}</a>
              : m.nom}
            {m.role && <span class="role">{m.role}</span>}
          </li>
        ))}
      </ul>
      {fondation.comite.aValider && <AValider quoi={fondation.comite.quoi} />}
    </dd>
  </div>

  <div>
    <dt>Valeurs</dt>
    <dd>{estAValider(fondation.valeurs)
      ? <AValider quoi={fondation.valeurs.quoi} />
      : fondation.valeurs}</dd>
  </div>
</div>
