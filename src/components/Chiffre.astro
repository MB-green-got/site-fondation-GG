---
/*
  Un chiffre, son libellé, sa date et le lien vers sa source.
  Un chiffre sans source ni date fait échouer la construction du site,
  il est donc impossible d'en publier un par inadvertance.
*/
const { valeur, libelle, date, sourceTitre, sourceUrl } = Astro.props;

if (!valeur) throw new Error('Chiffre sans valeur.');
if (!date) throw new Error(`Chiffre sans date, « ${valeur} ${libelle ?? ''} ». Tout chiffre porte une date.`);
if (!sourceUrl || !sourceTitre) {
  throw new Error(`Chiffre sans source, « ${valeur} ${libelle ?? ''} ». Tout chiffre porte une source liée.`);
}

const annee = String(date).slice(0, 4);
---
<p class="stat">
  <span class="n">{valeur}</span>
  <span class="t">
    {libelle}
    <a class="src" href={sourceUrl} target="_blank" rel="noopener">{sourceTitre}, {annee}</a>
  </span>
</p>
