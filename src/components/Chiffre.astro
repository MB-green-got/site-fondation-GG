---
/*
  Un chiffre, son libellé, sa date et sa source.

  Règle. Aucun chiffre ne s'affiche sans date ni sans source nommée, la
  construction du site échoue dans ce cas. Quand la source est nommée mais
  que son adresse manque, le chiffre s'affiche et la mention À VALIDER
  apparaît en clair à côté. Rien n'est inventé pour combler le trou.
*/
import AValider from './AValider.astro';
import { anneeUtile } from '../lib/dates.js';

const { valeur, libelle, date, sourceTitre, sourceUrl, sourceAValider } = Astro.props;

if (!valeur) throw new Error('Chiffre sans valeur.');
if (!sourceTitre) {
  throw new Error(`Chiffre sans source nommée, « ${valeur} ${libelle ?? ''} ». Tout chiffre porte une source.`);
}

const annee = anneeUtile(date, sourceTitre);
---
<p class="stat">
  <span class="n">{valeur}</span>
  <span class="t">
    {libelle}
    {sourceUrl
      ? <a class="src" href={sourceUrl} target="_blank" rel="noopener">{sourceTitre}{annee ? `, ${annee}` : ''}</a>
      : <span class="src">{sourceTitre}{annee ? `, ${annee}` : ''} <AValider court quoi="lien" /></span>}
    {!date && <AValider court quoi="date" />}
  </span>
</p>
