---
/*
  L'index des projets financés. Une ligne par projet, groupée par pilier.
  Aucun texte ne compte les projets, la liste compte toute seule et le
  nombre bougera au premier soutien de plus.
*/
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/FilAriane.astro';
import Signature from '../../components/Signature.astro';
import LigneIndex from '../../components/LigneIndex.astro';
import CarteProjets from '../../components/CarteProjets.astro';
import { fondation } from '../../data/fondation.js';

/* Les trois piliers, leur forme et leur couleur, repris de la maquette. */
const PILIERS = {
  'Terre': { forme: 'd', couleur: '#CDFB6E' },
  'Mer': { forme: 'c', couleur: '#C2E9FF' },
  'Recherche et éducation': { forme: 's', couleur: '#FFAD5C' },
};

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const piliers = ['Terre', 'Mer', 'Recherche et éducation'];
/* La date de mise à jour de l'index est celle de la fiche la plus récemment modifiée. */
const modifieLe = projets.map((e) => e.data.modifieLe).sort().at(-1);
const publieLe = '2026-09-18';

const chemin = [{ libelle: 'Projets' }];

const jsonLd = [{
  '@type': 'CollectionPage',
  '@id': 'https://fondation.green-got.com/projets#page',
  name: 'Les projets financés par la Fondation Green-Got',
  inLanguage: 'fr-FR',
  isPartOf: { '@id': 'https://fondation.green-got.com/#site' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projets.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://fondation.green-got.com/projets/${p.id}`,
      name: p.data.nom,
    })),
  },
}];
---
<Base
  titre={`Quels projets la Fondation Green-Got finance-t-elle ? · ${fondation.nom}`}
  description="Les projets financés par la Fondation Green-Got, rangés en trois piliers, la terre, la mer, la recherche et l'éducation. Chaque projet a un porteur, un lieu et un objet."
  route="/projets"
  chemin={chemin}
  image="/img/partage-projets.jpg"
  imageAlt="Les projets financés par la Fondation Green-Got"
  jsonLd={jsonLd}
>
  <section class="atlas" aria-labelledby="h-carte">
    <div class="container">
      <div class="ahead">
        <div class="ah-t">
          <FilAriane chemin={chemin} />
          <h1 id="h-carte">Nous soutenons ceux qui agissent. <br>De Roubaix à Bali.</h1>
          <p class="body">Chaque projet a un porteur, un lieu et un objet, et aucun n'aurait trouvé son financement ailleurs.</p>
          <Signature publieLe={publieLe} modifieLe={modifieLe} />
        </div>
        <div class="aleg" role="group" aria-label="Les trois piliers, légende de la carte">
          {piliers.map((pilier) => (
            <span>
              <i class={PILIERS[pilier].forme} aria-hidden="true" style={`background:${PILIERS[pilier].couleur}`}></i>
              <span class="lb">{pilier}</span>
              <span class="ct">{projets.filter((p) => p.data.pilier === pilier).length}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="agrid">
        <CarteProjets projets={projets.map((p) => p.data)} />
        <div class="alist">
          {piliers.map((pilier) => (
            <>
              <h2 class="agrp">{pilier}</h2>
              {projets.filter((p) => p.data.pilier === pilier).map((p) => (
                <LigneIndex
                  url={`/projets/${p.id}`}
                  vignette={p.data.image.fichier}
                  forme={PILIERS[p.data.pilier].forme}
                  couleur={PILIERS[p.data.pilier].couleur}
                  nom={p.data.nom}
                  complement={p.data.lieu}
                  objet={p.data.objet}
                />
              ))}
            </>
          ))}
        </div>
      </div>

      <p class="srcline">Chaque page de projet indique le montant versé et sa date d'arrêté. D'autres associations ont été soutenues par le passé, <a href="/soutiens-passes">elles figurent ici</a>.</p>
    </div>
  </section>
</Base>
