---
/*
  Accueil.

  Le plein cadre d'ouverture est celui de la maquette, un seul écran, vidéo
  de fond et accroche. Ce qui suit a été ajouté. La maquette s'arrêtait à
  l'écran d'ouverture et ne servait que 272 caractères, or c'est la page la
  plus susceptible d'être citée par un moteur de réponse, et c'était la plus
  pauvre du site.

  Rien n'est inventé ici. Tout vient de la fiche d'identité, des fiches de
  projet et de la page Faits et chiffres, et y renvoie.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Signature from '../components/Signature.astro';
import AValider from '../components/AValider.astro';
import { fondation } from '../data/fondation.js';
import { enClair } from '../lib/dates.js';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const evs = (await getCollection('evenements')).sort((a, b) => a.data.ordre - b.data.ordre);
const prochain = evs[0];

const publieLe = '2026-09-18';
const modifieLe = [
  ...projets.map((p) => p.data.modifieLe),
  ...evs.map((e) => e.data.modifieLe),
].sort().at(-1);

const titre = 'Fondation Green-Got, on finance ce qui ne rapporte rien';
const description = `${fondation.positionnement} Les projets financés contre les pesticides et la pollution plastique, de Roubaix à Bali, pour le vivant et la santé environnementale.`;
---
<Base
  titre={titre}
  description={description}
  route="/"
  image="/img/partage.jpg"
  imageAlt="Fondation Green-Got, on finance ce qui ne rapporte rien"
>
  <section class="fullhero solo" aria-labelledby="h-home">
    {/*
      Fond, la vidéo du site actuel. Le poster est la photo qui servait de
      fond, elle reste affichée tant que la vidéo n'est pas prête ou si le
      mouvement est réduit. Remplacer le fichier par le master HD dès réception.
    */}
    <video class="fh-bg fh-video" autoplay muted loop playsinline preload="metadata" poster="/img/agro.jpg" aria-label="Survol d'un verger en agroforesterie">
      <source src="/video/accueil.mp4" type="video/mp4">
    </video>
    <div class="fh-bg kb fh-poster" role="img" aria-label="Champ de céréales au lever du jour" style="background-image:var(--img-agro)"></div>
    <div class="fh-veil"></div>
    <div class="container fh-in">
      <p class="fh-kicker">Fondation Green‑Got</p>
      <h1 id="h-home">On finance ce qui ne rapporte rien.<br>Et qui compte le plus.</h1>
      <p class="fh-sub">Des rivières sans plastique, des terres sans pesticides, des mains qui apprennent à réparer ce qui mérite une seconde vie. Aucune banque ne finance ces combats. Nous, si.</p>
      <div class="cta">
        <a class="btn btn-p btn-xl" href="/la-fondation">Découvrir la Fondation</a>
      </div>
    </div>
  </section>

  <section class="sect" aria-labelledby="h-quoi">
    <div class="container lisible">
      <h2 id="h-quoi">Ce qu'est la Fondation Green‑Got.</h2>
      <p class="body lg">
        La Fondation Green‑Got est une {fondation.statut}. Elle finance la recherche et les
        projets de terrain sur {fondation.perimetre.join(', ')}. Son objectif est de
        {' '}{fondation.objectif}. Elle a été créée par <a href={fondation.fondateur.url} target="_blank" rel="noopener">Green‑Got</a>,
        {' '}{fondation.fondateur.qualitePhrase}, qui la finance par son mécénat.
      </p>
      <p class="body">
        L'équipe instruit les dossiers, le comité vote, une voix par administrateur, et la
        Fondation de France valide et exécute chaque versement. Aucun projet n'est financé
        sans ce vote. <a href="/la-fondation">Qui nous sommes et qui décide</a>, et
        {' '}<a href="/faits-et-chiffres">la page de référence en questions et réponses</a>.
      </p>
      <p class="body">Chaque projet financé a un porteur, un lieu et un objet, et aucun n'aurait trouvé son financement ailleurs. <a href="/projets">Les projets financés, situés sur une carte</a>.</p>
      <Signature publieLe={publieLe} modifieLe={modifieLe} />
    </div>
  </section>

  <section class="sect light" aria-labelledby="h-pourquoi">
    <div class="container lisible">
      <h2 id="h-pourquoi">Pourquoi ces combats.</h2>
      <p class="body lg">Le plastique et les pesticides viennent du pétrole. Les mêmes banques financent les pétroliers, les producteurs de plastique et les géants de l'agrochimie. Presque personne ne finance ceux qui réparent les sols et nettoient les rivières.</p>
      <p class="body">On paie deux fois. Une première fois en banque, quand l'épargne finance la pétrochimie. Une seconde en santé, quand ses substances reviennent dans l'assiette. <a href="/nos-combats">Le raisonnement et ses chiffres sourcés</a>.</p>
    </div>
  </section>

  <section class="sect" aria-labelledby="h-venir">
    <div class="container lisible">
      <h2 id="h-venir">Venir voir plutôt qu'en parler.</h2>
      {prochain && (
        <p class="body lg">
          Prochain rendez‑vous, {prochain.data.resume}, {prochain.data.avec},
          {' '}{prochain.data.debut
            ? <time datetime={prochain.data.debut.slice(0, 10)}>le {enClair(prochain.data.debut.slice(0, 10))}</time>
            : prochain.data.dateIncertaine}, {prochain.data.lieu}. {prochain.data.accesLibelle}.
          {' '}<a href={`/evenements/${prochain.id}`}>La fiche du rendez‑vous</a>.
        </p>
      )}
      <p class="body">Vous portez un projet de terrain et il vous manque l'argent pour le mener ? La Fondation étudie les dossiers et répond sous un mois. <a href="/associations">Comment candidater</a>.</p>
    </div>
  </section>
</Base>
